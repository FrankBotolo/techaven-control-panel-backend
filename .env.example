APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=errorlog
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SMTP Email Configuration (Brevo/Sendinblue)
# Port options: 587 (STARTTLS) or 465 (SSL)
# If port 587 times out, try port 465
# Get credentials from https://app.brevo.com → SMTP & API
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-login@smtp-brevo.com
SMTP_PASS=your-smtp-password-or-api-key
SMTP_FROM_EMAIL=noreply@yourdomain.com
# SMTP_DEBUG=true

# CORS allowed frontend origins (comma-separated)
# CORS_ORIGINS=http://72.61.16.221,http://localhost:3000

# Click Mobile SMS Gateway (OTP, password reset, order/payment notifications)
SMS_API_URL=http://206.225.81.36:8989/api/messaging/sendsms
SMS_BALANCE_URL=http://206.225.81.36/BalanceChecker/GetBalance.php
SMS_BEARER_TOKEN=your-api-key
SMS_SENDER_ID=TECHAVEN
SMS_ORG_ID=657

# Seller subscriptions: default is pending until payment/admin. Set SUBSCRIPTION_AUTO_ACTIVATE=true only in local dev to create active+paid rows without payment.
# SUBSCRIPTION_AUTO_ACTIVATE=true

# Airtel Money Direct API — outbound push: POST /api/orders/:id/pay/airtel; inbound: POST /api/webhooks/airtel
# Get credentials from the Airtel Money developer portal (Malawi)
# AIRTEL_ENV=production → https://openapi.airtel.mw (default staging: https://openapiuat.airtel.mw)
# Optional override: AIRTEL_API_BASE_URL=https://openapi.airtel.mw
# Token TTL is 180s; auto-refreshes ~30s before expiry (AIRTEL_TOKEN_REFRESH_BUFFER_SEC)
# Optional payment test defaults: AIRTEL_TEST_MSISDN, AIRTEL_TEST_ORDER_ID, AIRTEL_TEST_AMOUNT
# AIRTEL_WEBHOOK_SECRET: HMAC-SHA256 secret for verifying x-airtel-signature on inbound webhooks.
# Leave unset to skip signature verification (not recommended in production).
AIRTEL_ENV=staging
AIRTEL_CLIENT_ID=your-airtel-client-id
AIRTEL_CLIENT_SECRET=your-airtel-client-secret
AIRTEL_WEBHOOK_SECRET=your-airtel-webhook-secret

# Pay Changu — GET /api/webhooks/paychangu/callback (browser return URL); POST /api/webhooks/paychangu (dashboard webhook).
# PAYCHANGU_SECRET_KEY: Bearer token for /verify-payment; also used for webhook Signature if PAYCHANGU_WEBHOOK_SECRET is unset.
PAYCHANGU_SECRET_KEY=your-paychangu-secret-key
# Optional: separate secret from Pay Changu dashboard “API & Webhooks” (if they differ from API key).
# PAYCHANGU_WEBHOOK_SECRET=
# Public API base for docs/tools (no trailing slash), e.g. https://api.techaven.mw
# PUBLIC_API_BASE_URL=https://api.techaven.mw
# After verify, redirect the customer (302) — must be absolute URLs. Omit to return JSON instead.
# PAYCHANGU_REDIRECT_SUCCESS=https://www.techaven.mw/paychangu/callback
# PAYCHANGU_REDIRECT_FAILURE=https://www.techaven.mw/paychangu/callback

# Webhook capture mode: when true, only logs payloads to logs/webhook-captures/
# without processing. Use to inspect webhook format before adding logic.
# WEBHOOK_CAPTURE_ONLY=true

# --- User subscription access system (GET /api/plans, POST /api/subscribe) ---
# Force simulated payment failure (subscription not extended)
# SUBSCRIPTION_PAYMENT_SIMULATE_FAILURE=true
# Daily cron to set status=expired when end_date passed (node-cron pattern, UTC)
# SUBSCRIPTION_EXPIRY_CRON=5 0 * * *
