# Runtime
NODE_ENV=production
PORT=8000
APP_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# MySQL
# With Docker Compose, DB_HOST must remain `database`.
DB_HOST=database
DB_PORT=3306
DB_NAME=techaven
DB_USER=techaven
DB_PASSWORD=change-this-database-password
DB_ROOT_PASSWORD=change-this-root-password
DB_PUBLISHED_PORT=3306
DB_BOOTSTRAP=true
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_MS=2000

# Published backend port
BACKEND_PORT=8000

# Authentication
JWT_SECRET=change-this-long-random-jwt-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=

# Uploads
MAX_FILE_SIZE=5242880

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_DEBUG=false

# SMS
SMS_API_URL=
SMS_BALANCE_URL=
SMS_BEARER_TOKEN=
SMS_SENDER_ID=TECHAVEN
SMS_ORG_ID=

# Airtel Money
AIRTEL_ENV=staging
AIRTEL_API_BASE_URL=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_WEBHOOK_SECRET=
AIRTEL_TOKEN_REFRESH_BUFFER_SEC=30

# PayChangu
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_REDIRECT_SUCCESS=
PAYCHANGU_REDIRECT_FAILURE=

# Optional feature flags and schedulers
SUBSCRIPTION_AUTO_ACTIVATE=false
SUBSCRIPTION_PAYMENT_SIMULATE_FAILURE=false
SUBSCRIPTION_EXPIRY_INTERVAL_HOURS=6
WEBHOOK_CAPTURE_ONLY=false
