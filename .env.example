# Runtime
NODE_ENV=production
PORT=8000
APP_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
COMMERCE_SYNC_TOKEN=replace-with-a-long-random-token

# MySQL
# With Docker Compose, DB_HOST must remain `database`.
DB_HOST=database
DB_PORT=3306
DB_NAME=techaven
DB_USER=techaven
DB_PASSWORD=change-this-database-password
DB_ROOT_PASSWORD=change-this-root-password
DB_PUBLISHED_PORT=3306
DB_BOOTSTRAP=true
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_MS=2000

# Published backend port
BACKEND_PORT=8000

# Authentication
JWT_SECRET=change-this-long-random-jwt-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=

# Customer API v2: generate a unique random secret of at least 32 characters.
AUTH_V2_JWT_SECRET=
AUTH_V2_ALLOWED_ORIGINS=http://localhost:3001
# Enable only for explicitly allowed local HTTP development origins. HTTPS stays Secure.
AUTH_V2_ALLOW_HTTP=false
# Optional exact proxy IPs/CIDRs; do not use true or trust all forwarded headers.
TRUST_PROXY=

# Uploads
MAX_FILE_SIZE=5242880

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_DEBUG=false

# SMS
SMS_API_URL=
SMS_BALANCE_URL=
SMS_BEARER_TOKEN=
SMS_SENDER_ID=TECHAVEN
SMS_ORG_ID=

# Airtel Money
AIRTEL_ENV=staging
AIRTEL_API_BASE_URL=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_WEBHOOK_SECRET=
AIRTEL_TOKEN_REFRESH_BUFFER_SEC=30

# PayChangu
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_REDIRECT_SUCCESS=
PAYCHANGU_REDIRECT_FAILURE=

# Optional feature flags and schedulers
SUBSCRIPTION_AUTO_ACTIVATE=false
SUBSCRIPTION_PAYMENT_SIMULATE_FAILURE=false
SUBSCRIPTION_EXPIRY_INTERVAL_HOURS=6
WEBHOOK_CAPTURE_ONLY=false

# Bank-transfer checkout and transaction links
FRONTEND_URL=
MANUAL_PAYMENTS_ENABLED=false
MANUAL_PAYMENT_REVIEW_READY=false
MANUAL_PAYMENT_WHATSAPP=
PAYMENT_PROOF_DIR=private/payment-proofs

# Optional single-account override for portal/manual payment instructions.
MANUAL_PAYMENT_PROVIDER=
MANUAL_PAYMENT_ACCOUNT_NAME=
MANUAL_PAYMENT_ACCOUNT_NUMBER=
# Promotion previews and optional address lookup.
PREVIEW_SECRET=
PREVIEW_FRONTEND_URL=http://localhost:3001
GEOAPIFY_SERVER_KEY=
GEOAPIFY_BROWSER_KEY=
# Development-only OTP diagnostics; ignored when NODE_ENV=production.
AUTH_RATE_LIMIT_DISABLED=false
AUTH_DEV_LOG_OTP=false
# FDI SMS delivery used by the production fork. Keep credentials server-only.
FDI_SMS_API_USERNAME=
FDI_SMS_API_PASSWORD=
FDI_SMS_SENDER_ID=TECHAVEN
# Published campaigns eligible for shop participation (Strapi origin).
CMS_PROMOTIONS_API_URL=https://cms.techavenmw.com

# Password for shop owner accounts created by npm run seed:commerce:apply (8+ characters)
SEED_SELLER_PASSWORD=
# Subscription given to every seeded shop: package slug and length in days
SEED_SUBSCRIPTION_PACKAGE=growth
SEED_SUBSCRIPTION_DAYS=365

# Cloudflare R2: all uploads (portal images, promotion artwork, payment receipts). Required in production.
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://<public-bucket-domain>
