{
  "name": "chiwaya-server",
  "version": "1.0.0",
  "description": "Chiwaya API Server - Node.js/Express",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node scripts/run-integration-tests.js",
    "test:all": "npm test && npm run test:integration",
    "start": "node server.js",
    "docker:bootstrap": "node scripts/bootstrap-database.js",
    "dev": "nodemon server.js",
    "create-db": "node scripts/create-db.js",
    "migrate": "node scripts/migrate.js",
    "migrate:v2": "node scripts/run-migrations.js up",
    "migrate:v2:status": "node scripts/run-migrations.js status",
    "migrate:v2:dry-run": "node scripts/run-migrations.js up --dry-run",
    "migrate:v2:down": "node scripts/run-migrations.js down",
    "catalog:import:techapi": "node scripts/import-techapi.js",
    "catalog:migrate-legacy": "node scripts/migrate-legacy-products.js",
    "catalog:backfill-promotions": "node scripts/backfill-promotion-catalogue.js",
    "migrate:fresh": "node scripts/migrate-fresh.js",
    "migrate:fresh:seed": "node scripts/migrate-fresh.js && node scripts/seed.js",
    "add-specifications": "node scripts/add-specifications-column.js",
    "add-escrow": "node scripts/add-escrow-to-orders.js",
    "add-google-oauth": "node scripts/add-google-oauth.js",
    "auto-confirm": "node scripts/auto-confirm-delivery.js",
    "test-email": "node scripts/test-email.js",
    "test-notification-email": "node scripts/test-notification-email.js",
    "test-single-notification": "node scripts/test-single-notification.js",
    "test-smtp": "node scripts/test-smtp-connection.js",
    "test-sms": "node scripts/test-sms.js",
    "test-airtel": "node scripts/test-airtel-token.js",
    "test-airtel-payment": "node scripts/test-airtel-payment.js",
    "test-airtel-transaction": "node scripts/test-airtel-transaction.js",
    "fix-invitations": "node scripts/fix-invitations-timestamps.js",
    "seed": "node scripts/seed.js",
    "setup": "npm run create-db && npm run migrate && npm run seed",
    "seed:promotions": "node scripts/seed-promotions.js",
    "seed:variants": "node scripts/seed-device-variants.js",
    "seed:variants:apply": "node scripts/seed-device-variants.js --apply",
    "seed:packages": "node scripts/seed-subscription-packages.js",
    "seed:packages:apply": "node scripts/seed-subscription-packages.js --apply"
  },
  "keywords": [
    "express",
    "api",
    "mysql"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.9.7",
    "sequelize": "^6.35.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
